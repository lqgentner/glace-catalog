# Category 3: neither tracked in git nor published.
#
# Data files are generated or downloaded, live in object storage, and are
# never committed. The metadata under catalog/ IS committed; only the bytes it
# describes are not. Git keeps every version of a binary forever, so one large
# file committed once is paid for by every clone from then on, and deleting it
# later reclaims nothing.
*.parquet
*.pmtiles
*.tif
*.tiff
*.zarr/
*.copc.laz
*.laz
*.geojsonl
*.gpkg
*.shp
*.zip

# Downloaded sources and build scratch. Re-fetchable by your own tooling.
sources/
staging/*/data/
.cache/

# Secrets
.env
.env.*
!.env.example

# OS, editor, and tooling noise
.DS_Store
__pycache__/
*.pyc
.venv/
.ruff_cache/

# --- GLACE: generated catalog documents -------------------------------------
# The hand-maintained documents are committed: the root catalog, both
# collection.json, and every README.md / AGENTS.md down to the collection level.
# Everything below is generated by scripts/build-year.py into the same tree
# and uploaded from there, so it publishes without ever being committed. The
# Alps hold about 2 210 items a year over twelve years; committing 26 500
# generated JSON files would make every clone and every diff pay for output
# nobody reviews by hand.
catalog/tiles/[0-9][0-9][0-9][0-9]/
catalog/mosaics/[0-9][0-9][0-9][0-9]/
catalog/**/items.parquet
catalog/**/thumbnail.webp

# Build state and the per-year slice of the item mirror. Never published.
.build-state.json
.items.parquet

# uv
.venv/

