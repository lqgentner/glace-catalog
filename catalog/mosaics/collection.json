  "renders": {
    "coh12_vv": {
      "title": "COH12 VV — 12-day coherence, co-polarised",
      "assets": [
        "coh12_vv"
      ],
      "rescale": [
        [
          0.1,
          0.8
        ]
      ],
      "colormap_name": "magma",
      "resampling": "average",
      "nodata": "nan"
    },
    "coh12_vh": {
      "title": "COH12 VH — 12-day coherence, cross-polarised",
      "assets": [
        "coh12_vh"
      ],
      "rescale": [
        [
          0.1,
          0.6
        ]
      ],
      "colormap_name": "magma",
      "resampling": "average",
      "nodata": "nan"
    },
    "rtc_vv": {
      "title": "RTC VV — terrain-corrected backscatter, co-polarised (dB)",
      "assets": [
        "rtc_vv"
      ],
      "expression": "10*log10(rtc_vv_b1)",
      "rescale": [
        [
          -18.5,
          -5.0
        ]
      ],
      "colormap_name": "gray",
      "resampling": "average",
      "nodata": "nan"
    },
    "rtc_vh": {
      "title": "RTC VH — terrain-corrected backscatter, cross-polarised (dB)",
      "assets": [
        "rtc_vh"
      ],
      "expression": "10*log10(rtc_vh_b1)",
      "rescale": [
