          0.1,
          0.6
        ]
      ],
      "colormap_name": "magma",
      "resampling": "average",
      "nodata": "nan"
    },
    "rtc_vv": {
      "title": "RTC VV — terrain-corrected backscatter, co-polarised (dB)",
      "assets": [
        "rtc_vv"
      ],
      "expression": "10*log10(rtc_vv_b1)",
      "rescale": [
        [
          -18.5,
          -5.0
        ]
      ],
      "colormap_name": "gray",
      "resampling": "average",
      "nodata": "nan"
    },
    "rtc_vh": {
      "title": "RTC VH — terrain-corrected backscatter, cross-polarised (dB)",
      "assets": [
        "rtc_vh"
      ],
      "expression": "10*log10(rtc_vh_b1)",
      "rescale": [
        [
          -26.0,
          -11.0
        ]
      ],
      "colormap_name": "gray",
      "resampling": "average",
      "nodata": "nan"
    },
    "coh12_rgb": {
      "title": "COH12 false colour — R: VV, G: VH, B: VV/VH",
      "assets": [
        "coh12_rgb"
      ],
      "resampling": "average"
    },
    "rtc_rgb": {
      "title": "RTC false colour — R: VV, G: VH, B: VV-VH (all dB)",
      "assets": [
        "rtc_rgb"
      ],
      "resampling": "average"
    }
  },
