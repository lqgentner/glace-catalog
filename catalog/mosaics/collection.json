      "title": "COH12 VV — 12-day coherence, co-polarised",
      "assets": [
        "coh12_vv"
      ],
      "rescale": [
        [
          0.1,
          0.8
        ]
      ],
      "colormap_name": "magma",
      "resampling": "average",
      "nodata": "nan"
    },
    "coh12_vh": {
      "title": "COH12 VH — 12-day coherence, cross-polarised",
      "assets": [
        "coh12_vh"
      ],
      "rescale": [
