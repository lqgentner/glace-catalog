  "id": "glace-ch-mosaics",
  "title": "GLACE mosaics — annual Sentinel-1 composites on a fixed WebMercator grid",
  "description": "One mosaic per year of the GLACE Switzerland composites, warped from the 10 m MGRS tiles onto the WebMercatorQuad grid at zoom 13 (19.109 m, about 13.2 m on the ground at 46.5 degrees north). Every year sits on the same fixed grid, hard-coded rather than derived from whichever tiles happen to exist, so the series stacks and differences with no alignment step. Aligning to the tile matrix also means the COGs' internal overview levels land exactly on zoom 12, 11 and below: each file is itself a tile pyramid, and a browser reading it at low zoom fetches a decimated overview rather than full-resolution pixels it would discard. Twelve single-band analysis rasters per year in linear units, plus two false-colour renderings for display. The observation-count layers become a mean rather than a count under averaging, and are described as such.",
  "license": "CC-BY-4.0",
  "keywords": [
    "Sentinel-1",
    "SAR",
    "InSAR coherence",
    "backscatter",
    "glaciers",
    "Switzerland",
    "Alps",
    "mosaic",
    "cryosphere"
  ],
  "version": "1.0",
  "providers": [
    {
      "name": "University of Zurich, Department of Geography",
      "description": "Produced the composites from Copernicus Sentinel-1 SLC data, derived the annual mosaics, and maintains this catalog. Hosted on Source Cooperative storage; corrections go through the catalog's issue tracker.",
      "roles": [
        "producer",
        "processor",
        "licensor",
        "host"
      ],
      "url": "https://www.geo.uzh.ch/en/units/gis.html"
    }
  ],
