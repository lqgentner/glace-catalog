  "id": "glace-ch-tiles",
  "title": "GLACE tiles – Sentinel-1 Composites on MGRS squares (10 m)",
  "description": "The GLACE composites on 10 km MGRS grid squares in their own UTM zone at 10 m grid spacing, one item per square and year. Each item carries twelve single-band Cloud-Optimized GeoTIFFs: coherence and backscatter in VV and VH, and for each of the four a contributing-observations count and a composite quality map. Stored values are linear; the decibel display conversion (`10*log10(x)`) is declared in the renders. Query the tiles with the item mirror `items.parquet`.",
  "license": "CC-BY-4.0",
  "keywords": [
    "Sentinel-1",
    "SAR",
    "InSAR coherence",
    "Backscatter",
    "Glaciers",
    "Cryosphere",
    "Alps",
    "MGRS"
  ],
  "version": "0.1",
  "providers": [
    {
      "name": "European Space Agency / Copernicus",
      "description": "Operates the Sentinel-1 mission and distributes the SLC data these composites are derived from, through the Copernicus Data Space Ecosystem.",
      "roles": [
        "producer",
        "licensor"
      ],
      "url": "https://sentinel.esa.int/web/sentinel/missions/sentinel-1"
    },
    {
      "name": "University of Zurich, Department of Geography",
      "description": "Produced the composites from Copernicus Sentinel-1 SLC data: burst extraction, coherence estimation, radiometric terrain correction and local resolution weighted compositing. Derived the annual mosaics and maintains this catalog.",
      "roles": [
        "producer",
        "processor",
        "licensor",
        "host"
      ],
      "url": "https://www.geo.uzh.ch/en.html"
    }
  ],
  "extent": {
    "spatial": {
      "bbox": [
        [
          6.7676,
          45.8288,
          10.459,
          47.3388
        ]
      ]
    },
    "temporal": {
      "interval": [
        [
          "2021-01-01T00:00:00Z",
          "2025-01-01T00:00:00Z"
        ]
      ]
    }
  },
  "renders": {
